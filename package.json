{
  "name": "kyro-store",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda online independiente de KYRO.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "dev:fixtures": "node scripts/run-astro.mjs --fixtures dev",
    "build": "astro build",
    "build:fixtures": "node scripts/run-astro.mjs --fixtures build",
    "build:e2e": "node scripts/run-astro.mjs --fixtures --test-logo build",
    "preview": "astro preview",
    "preview:fixtures": "node scripts/run-astro.mjs --fixtures preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run build:e2e && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
