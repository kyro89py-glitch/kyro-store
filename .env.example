# Copia este archivo como .env para valores locales. .env nunca se sube a Git.
# En esta fase no hay secretos: el sitio es estático y no procesa pagos.

# URL pública definitiva, cuando exista dominio (p. ej. https://kyro.example).
KYRO_SITE_URL=

# Prefijo de ruta si el sitio se sirve desde un subdirectorio (p. ej. /kyro-store).
KYRO_BASE_PATH=

# Fase 2 (no usar todavía): las claves de la pasarela de pago y de la base de datos
# irán SOLO en las variables de entorno del hosting, nunca en este repositorio.
