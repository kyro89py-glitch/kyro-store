---
import { getActiveProducts, getCategories } from '../../lib/catalog';
import { routes } from '../../lib/urls';
import Wordmark from '../brand/Wordmark.astro';
import CartToggle from '../cart/CartToggle.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  /** "overlay": transparente sobre la portada hasta que se hace scroll. */
  variant?: 'solid' | 'overlay';
}
const { variant = 'solid' } = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { label: 'Tienda', href: routes.shop() },
  { label: 'Marca', href: routes.brand() },
];
const isCurrent = (href: string) => path === href || (href !== routes.home() && path.startsWith(href));
const categories = getCategories(await getActiveProducts()).map((category) => ({
  label: category.name,
  href: routes.category(category.slug),
}));
---

<kyro-header class:list={['site-header', `site-header--${variant}`]}>
  <div class="site-header__inner">
    <nav class="site-header__nav" aria-label="Principal">
      <MobileMenu links={nav} categories={categories} />
      <ul class="site-header__links" role="list">
        {
          nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="site-header__brand" href={routes.home()} aria-label="KYRO, inicio">
      <Wordmark />
    </a>

    <div class="site-header__actions">
      <CartToggle />
    </div>
  </div>
</kyro-header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: block;
    background: rgb(14 16 18 / 0.88);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(14px) saturate(1.1);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  /* La portada se dibuja por debajo de la cabecera. */
  .site-header--overlay {
    margin-bottom: calc(-1 * var(--header-height) - 1px);
  }

  .site-header--overlay:not([data-scrolled]) {
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100% - 2 * var(--gutter), var(--max-width));
    min-height: var(--header-height);
    margin-inline: auto;
  }

  .site-header__links {
    display: none;
    gap: var(--space-xl);
  }

  .site-header__links a {
    font-size: var(--text-sm);
  }

  .site-header__brand {
    font-size: var(--text-md);
    text-decoration: none;
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 48rem) {
    .site-header__links {
      display: flex;
    }

    .site-header__brand {
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  // En la portada la cabecera es transparente sobre la apertura y se vuelve sólida
  // en cuanto la cartela deja de verse.
  class KyroHeader extends HTMLElement {
    #observer: IntersectionObserver | undefined;

    connectedCallback() {
      const sentinel = document.querySelector('[data-header-sentinel]');
      if (!this.classList.contains('site-header--overlay') || !sentinel) return;
      this.#observer = new IntersectionObserver(([entry]) => {
        this.toggleAttribute('data-scrolled', !entry?.isIntersecting);
      });
      this.#observer.observe(sentinel);
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
    }
  }

  if (!customElements.get('kyro-header')) {
    customElements.define('kyro-header', KyroHeader);
  }
</script>
