---
import { routes } from '../../lib/urls';
import Wordmark from '../brand/Wordmark.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  links: Link[];
  categories?: Link[];
}
const { links, categories = [] } = Astro.props;
const items = [{ label: 'Inicio', href: routes.home() }, ...links, { label: 'Carrito', href: routes.cart() }];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== routes.home() && path.startsWith(href));

/*
 * Menú en pantalla completa para móvil: se abre como una cortina de arriba abajo,
 * los enlaces entran en escalera con su número de "plano" y al pie queda KYRO a todo
 * el ancho, en contorno. Al cerrar, la cortina vuelve a subir.
 */
---

<kyro-menu class="menu">
  <button class="menu__open" type="button" aria-haspopup="dialog" data-menu-open>Menú</button>
  <dialog class="menu__dialog" aria-label="Menú">
    <div class="menu__panel">
      <div class="menu__bar">
        <button class="menu__close" type="button" data-menu-close>Cerrar</button>
      </div>
      <ul class="menu__list" role="list">
        {
          items.map((item, index) => (
            <li class="menu__item">
              <a class="menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="menu__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="menu__label editorial">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        categories.length > 0 && (
          <div class="menu__categories">
            <p class="menu__heading" id="menu-categorias">
              Categorías
            </p>
            <ul role="list" aria-labelledby="menu-categorias">
              {categories.map((category) => (
                <li>
                  <a class="nav-link" href={category.href}>
                    {category.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="menu__masthead" aria-hidden="true">
        <Wordmark variant="masthead" dimensional="static" />
      </div>
    </div>
  </dialog>
</kyro-menu>

<style>
  .menu__open,
  .menu__close {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-stretch: 112%;
    letter-spacing: 0.03em;
  }

  .menu__open:active,
  .menu__close:active {
    color: var(--color-champagne);
  }

  /* Cortina: se abre de arriba abajo con el ritmo del obturador y se recoge al cerrar. */
  .menu__dialog {
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: var(--color-obsidian-deep);
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 620ms var(--ease-shutter),
      overlay 620ms allow-discrete,
      display 620ms allow-discrete;
  }

  .menu__dialog[open] {
    clip-path: inset(0 0 0 0);
  }

  @starting-style {
    .menu__dialog[open] {
      clip-path: inset(0 0 100% 0);
    }
  }

  .menu__dialog::backdrop {
    background: transparent;
    backdrop-filter: none;
  }

  .menu__panel {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    height: 100%;
    padding-inline: var(--gutter);
    overflow: hidden auto;
  }

  .menu__bar {
    display: flex;
    align-items: center;
    min-height: var(--header-height);
  }

  .menu__list {
    display: grid;
    align-content: center;
    gap: var(--space-xs);
    padding-block: var(--space-xl);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-2xs);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .menu__index {
    min-width: 1.6rem;
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  .menu__label {
    font-size: clamp(2.6rem, 1.6rem + 6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .menu__link[aria-current='page'] .menu__label {
    font-style: italic;
  }

  .menu__link[aria-current='page'] .menu__index,
  .menu__link:active {
    color: var(--color-champagne);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu__link:hover {
      color: var(--color-champagne);
    }
  }

  /* Escalera de entrada: cada enlace sube desde una máscara, uno tras otro. */
  /* La máscara deja 0.375rem alrededor para que el anillo de foco no se recorte. */
  .menu__item {
    margin: -0.375rem;
    padding: 0.375rem;
    clip-path: inset(0);
  }

  .menu__link {
    translate: 0 130%;
    transition:
      translate 820ms var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .menu__dialog[open] .menu__link {
    translate: 0 0;
  }

  @starting-style {
    .menu__dialog[open] .menu__link {
      translate: 0 130%;
    }
  }

  .menu__item:nth-child(1) .menu__link { transition-delay: 180ms, 0ms; }
  .menu__item:nth-child(2) .menu__link { transition-delay: 240ms, 0ms; }
  .menu__item:nth-child(3) .menu__link { transition-delay: 300ms, 0ms; }
  .menu__item:nth-child(4) .menu__link { transition-delay: 360ms, 0ms; }
  .menu__item:nth-child(5) .menu__link { transition-delay: 420ms, 0ms; }

  .menu__categories {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out) 420ms;
  }

  .menu__dialog[open] .menu__categories {
    opacity: 1;
  }

  @starting-style {
    .menu__dialog[open] .menu__categories {
      opacity: 0;
    }
  }

  .menu__heading {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.06em;
  }

  .menu__categories ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }

  .menu__categories a {
    display: inline-block;
    padding-block: var(--space-2xs);
  }

  /* KYRO en contorno, a todo el ancho, como firma al pie de la cortina. */
  .menu__masthead {
    padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
    container-type: inline-size;
    opacity: 0;
    translate: 0 30%;
    transition:
      opacity 900ms var(--ease-out) 300ms,
      translate 1100ms var(--ease-out) 300ms;
  }

  .menu__masthead :global(.masthead) {
    font-size: 23.5cqi;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-line-strong);
  }

  .menu__masthead :global(.logo) {
    width: 100%;
    height: auto;
    color: var(--color-line-strong);
  }

  .menu__dialog[open] .menu__masthead {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .menu__dialog[open] .menu__masthead {
      opacity: 0;
      translate: 0 30%;
    }
  }

  @media (forced-colors: active) {
    .menu__masthead :global(.masthead) {
      color: CanvasText;
      -webkit-text-stroke: 0;
    }
  }

  @media (min-width: 48rem) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  class KyroMenu extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog');
      if (!dialog) return;
      this.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog.showModal());
      this.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
      // Si la pantalla crece hasta escritorio con el menú abierto, se cierra.
      window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
        if (event.matches) dialog.close();
      });
    }
  }

  if (!customElements.get('kyro-menu')) {
    customElements.define('kyro-menu', KyroMenu);
  }
</script>
