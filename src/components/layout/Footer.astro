---
import { copy } from '../../config/copy';
import { store } from '../../config/store';
import { getActiveProducts, getCategories } from '../../lib/catalog';
import { getInfoPages } from '../../lib/pages';
import { routes } from '../../lib/urls';
import Wordmark from '../brand/Wordmark.astro';

const year = new Date().getFullYear();
const categories = getCategories(await getActiveProducts()).slice(0, 6);
const infoPages = await getInfoPages();
const hasContact = Boolean(store.contact.email) || store.social.length > 0;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__statement editorial-italic" data-reveal="title">{copy.footer.statement}</p>

    <nav class="site-footer__nav" aria-label="Pie de página">
      <div class="site-footer__group">
        <h2 class="site-footer__heading">Tienda</h2>
        <ul role="list">
          <li><a class="nav-link" href={routes.shop()}>Toda la tienda</a></li>
          {
            categories.map((category) => (
              <li>
                <a class="nav-link" href={routes.category(category.slug)}>
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__group">
        <h2 class="site-footer__heading">KYRO</h2>
        <ul role="list">
          <li><a class="nav-link" href={routes.brand()}>La marca</a></li>
          <li><a class="nav-link" href={routes.cart()}>Carrito</a></li>
        </ul>
      </div>

      {
        infoPages.length > 0 && (
          <div class="site-footer__group">
            <h2 class="site-footer__heading">Información</h2>
            <ul role="list">
              {infoPages.map((page) => (
                <li>
                  <a class="nav-link" href={routes.info(page.id)}>
                    {page.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        hasContact && (
          <div class="site-footer__group">
            <h2 class="site-footer__heading">Contacto</h2>
            <ul role="list">
              {store.contact.email && (
                <li>
                  <a class="nav-link" href={`mailto:${store.contact.email}`}>
                    {store.contact.email}
                  </a>
                </li>
              )}
              {store.social.map((link) => (
                <li>
                  <a class="nav-link" href={link.url} rel="noopener noreferrer" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </nav>

    <a class="site-footer__masthead" href={routes.home()} aria-label="KYRO, inicio">
      <Wordmark variant="masthead" reveal />
    </a>

    <p class="site-footer__legal">© {year} {store.name}</p>
  </div>
</footer>

<style>
  /*
   * Pie como títulos de crédito: una frase de marca, el índice del sitio y, al cierre,
   * KYRO a todo el ancho (eco de la portada). Las letras suben al entrar en pantalla.
   */
  .site-footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-lg);
    border-top: 1px solid var(--color-line);
    background: var(--color-obsidian-deep);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .site-footer__statement {
    max-width: 16em;
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.9rem);
    line-height: 1.08;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-xl);
  }

  .site-footer__group {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
  }

  .site-footer__heading {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .site-footer__group ul {
    display: grid;
    gap: var(--space-xs);
  }

  .site-footer__group a {
    font-size: var(--text-sm);
  }

  .site-footer__masthead {
    display: block;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
    text-decoration: none;
    container-type: inline-size;
    transition: color var(--duration-slow) var(--ease-out);
  }

  .site-footer__masthead :global(.masthead) {
    font-size: 25cqi;
  }

  .site-footer__masthead :global(.logo) {
    width: 100%;
    height: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__masthead:hover {
      color: var(--color-champagne);
    }
  }

  .site-footer__legal {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
  }

  @media (min-width: 60rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-2xl);
    }

    .site-footer__masthead,
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
