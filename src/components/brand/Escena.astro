---
import { copy } from '../../config/copy';
import { routes } from '../../lib/urls';
import { OfficialLogo } from './logo';
import Wordmark from './Wordmark.astro';

/*
 * Portada «Cámara oscura» (EXPLORACIÓN; el KYRO tipográfico es provisional).
 *
 * Una pista alta con un escenario fijo: mientras se recorre, la cámara del mundo 3D
 * (src/scripts/3d/escena.ts, lienzo fijo detrás) orbita KYRO y avanza hacia las
 * colecciones. Encima, solo lo imprescindible: la frase, la llamada a las colecciones y
 * una pista de desplazamiento.
 *
 * Sin JavaScript, sin WebGL, con colores forzados o con "reducir movimiento", la pista
 * mide una pantalla y se ve el KYRO plano sobre una luz hecha con CSS: la tienda funciona
 * igual. El mundo 3D solo se dibuja con el KYRO tipográfico; si existe el logotipo
 * oficial (SVG), se muestra ese, plano, hasta generar su geometría.
 */
interface Props {
  /** Destino de "Explorar las colecciones" (la sección de colecciones de la portada). */
  collectionsHref: string;
}
const { collectionsHref } = Astro.props;
const world = !OfficialLogo;
---

<section class="escena" aria-labelledby="escena-titulo" data-escena={world ? '' : undefined}>
  {world && <div class="escena__mundo" data-escena-lienzo aria-hidden="true" />}
  <div class="escena__escenario" data-escena-gesto>
    <h1 class="escena__titulo" id="escena-titulo" data-header-sentinel>
      <Wordmark variant="masthead" class="escena__marca" />
    </h1>

    <div class="escena__hud">
      <p class="escena__linea editorial-italic">{copy.hero.line}</p>
      <div class="escena__acciones">
        <a class="button button--primary" href={collectionsHref} data-escena-ir>Explorar las colecciones</a>
        <a class="text-link" href={routes.brand()}>Conocer la marca</a>
      </div>
    </div>

    <p class="escena__pista" aria-hidden="true">
      <span class="escena__pista-linea"></span>
      <span class="escena__pista-texto">Desliza</span>
    </p>
  </div>
</section>

<style>
  /* ---------- Pista y escenario ---------- */

  .escena {
    position: relative;
    height: 100svh;
  }

  /* Con el mundo 3D activo, la pista se alarga: ese recorrido mueve la cámara. */
  :global(html.motion.dim) .escena[data-escena]:not([data-escena3d='failed']) {
    height: 230svh;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.motion.dim) .escena[data-escena]:not([data-escena3d='failed']) {
      height: 100svh;
    }
  }

  .escena__escenario {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100svh;
    padding: calc(var(--header-height) + var(--space-md)) var(--gutter) var(--space-lg);
    overflow: clip;
    container-type: inline-size;
    /* El gesto horizontal es de la escena; el vertical sigue siendo desplazamiento. */
    touch-action: pan-y;
  }

  /* El lienzo fijo vive detrás de todo el contenido de la página. */
  .escena__mundo {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .escena__mundo[data-oculto] {
    visibility: hidden;
  }

  .escena__mundo :global(.escena__lienzo) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .escena[data-escena3d='ready'] .escena__mundo :global(.escena__lienzo) {
    opacity: 1;
  }

  /* Respaldo sin 3D: una luz de proyector hecha con degradados y un suelo que brilla. */
  :global(html:not(.dim)) .escena__escenario,
  .escena:not([data-escena]) .escena__escenario,
  .escena[data-escena3d='failed'] .escena__escenario {
    background:
      linear-gradient(
          118deg,
          transparent 18%,
          rgb(200 179 138 / 0.1) 30%,
          rgb(200 179 138 / 0.04) 44%,
          transparent 58%
        )
        no-repeat,
      radial-gradient(ellipse 55% 18% at 52% 66%, rgb(200 179 138 / 0.12), transparent 70%),
      var(--color-obsidian-deep);
  }

  /* ---------- KYRO ---------- */

  .escena__titulo {
    grid-row: 1;
    align-self: center;
    justify-self: center;
    width: 86%;
    margin-top: 4svh;
    container-type: inline-size;
  }

  .escena__titulo :global(.escena__marca) {
    font-size: 25cqi;
  }

  .escena__titulo :global(.logo) {
    width: 100%;
    height: auto;
  }

  /* Con el mundo 3D, las letras planas ceden su sitio (siguen en el HTML). */
  :global(html.dim) .escena[data-escena]:not([data-escena3d='failed']) .escena__titulo :global(.masthead__letter) {
    visibility: hidden;
  }

  @media (min-width: 48rem) {
    .escena__titulo {
      width: 74%;
    }
  }

  /* ---------- Frase y acciones ---------- */

  .escena__hud {
    grid-row: 2;
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    max-width: 30rem;
    /* Se apaga en cuanto la cámara empieza a moverse. */
    opacity: calc(1 - var(--h, 0) * 5);
    /* Entra pronto (mientras la luz revela KYRO): es el primer texto que se lee. */
    animation: escena-entra 800ms var(--ease-out) 450ms backwards;
  }

  .escena[data-lejos] .escena__hud {
    pointer-events: none;
  }

  .escena__hud:focus-within {
    opacity: 1;
  }

  .escena__linea {
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.05;
  }

  .escena__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
  }

  /* ---------- Pista de desplazamiento ---------- */

  .escena__pista {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-lg);
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.08em;
    opacity: calc(1 - var(--h, 0) * 8);
    animation: escena-entra 900ms var(--ease-out) 1800ms backwards;
  }

  .escena__pista-linea {
    width: 1px;
    height: 3rem;
    overflow: hidden;
    background: var(--color-line);
  }

  .escena__pista-linea::after {
    content: '';
    display: block;
    width: 100%;
    height: 40%;
    background: var(--color-champagne);
  }

  @media (prefers-reduced-motion: no-preference) {
    .escena__pista-linea::after {
      animation: escena-pista 2.4s var(--ease-in-out) infinite;
    }
  }

  /* Sin recorrido (sin 3D o con movimiento reducido) la pista no tiene sentido. */
  :global(html:not(.dim)) .escena__pista,
  .escena:not([data-escena]) .escena__pista,
  .escena[data-escena3d='failed'] .escena__pista {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .escena__pista {
      display: none;
    }
  }

  @keyframes escena-entra {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  @keyframes escena-pista {
    from {
      translate: 0 -100%;
    }
    to {
      translate: 0 260%;
    }
  }
</style>

<script>
  // Arranca el mundo 3D (módulo aparte) y lleva "Explorar las colecciones" hasta ellas
  // con un recorrido suave de cámara: el desplazamiento mueve la escena.
  const root = document.querySelector<HTMLElement>('[data-escena]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (root && document.documentElement.classList.contains('dim')) {
    import('../../scripts/3d/escena')
      .then(({ init }) => init(root))
      .catch(() => {
        root.dataset['escena3d'] = 'failed';
      });

    // Más allá del primer tramo, la frase y la llamada se apagan y dejan de recibir clics.
    const update = () => {
      const rect = root.getBoundingClientRect();
      root.toggleAttribute('data-lejos', -rect.top > innerHeight * 0.22);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }

  document.querySelector<HTMLAnchorElement>('[data-escena-ir]')?.addEventListener('click', (event) => {
    const link = event.currentTarget as HTMLAnchorElement;
    const target = link.hash ? document.querySelector(link.hash) : null;
    if (!target) return;
    event.preventDefault();
    target.scrollIntoView({ behavior: reduced.matches ? 'auto' : 'smooth', block: 'start' });
    history.replaceState(null, '', link.hash);
  });
</script>
