---
import { OfficialLogo } from './logo';

/*
 * Logotipo de KYRO en todo el sitio.
 *
 * Si existe el logotipo oficial en src/assets/brand/logo.svg, se usa ese archivo.
 * Mientras no exista, se muestra el logotipo tipográfico PROVISIONAL "KYRO" (no es un
 * logotipo oficial). El SVG debe pintar con `currentColor` (ver docs/MARCA.md).
 *
 * variant="mark"      navegación y pie (tamaño de texto).
 * variant="masthead"  cabecera de revista a todo el ancho; en la versión tipográfica
 *                     cada letra es un elemento para poder revelarlas por separado.
 * reveal              (masthead) las letras suben una a una al entrar en pantalla.
 * dimensional         (masthead) EXPLORACIÓN: la versión en 3D real (src/scripts/wordmark-3d.ts)
 *                     sustituye a las letras planas si hay WebGL; "hero" en la portada,
 *                     "static" en el pie y el menú. Sin WebGL quedan las letras planas.
 */
interface Props {
  class?: string;
  variant?: 'mark' | 'masthead';
  reveal?: boolean;
  dimensional?: 'hero' | 'static' | undefined;
  [key: string]: unknown;
}
const { class: className, variant = 'mark', reveal = false, dimensional, ...rest } = Astro.props;

const Logo = OfficialLogo;
const letters = [...'KYRO'];
---

{
  Logo ? (
    <Logo
      class:list={['logo', `logo--${variant}`, className]}
      role="img"
      aria-label="KYRO"
      data-reveal={reveal ? 'rise' : undefined}
      {...rest}
    />
  ) : variant === 'masthead' ? (
    <span class:list={['masthead', className]} data-wordmark-3d={dimensional} {...rest}>
      <span class="visually-hidden">KYRO</span>
      {letters.map((letter) => (
        <span class="masthead__letter" aria-hidden="true" data-reveal={reveal ? 'title' : undefined}>
          {letter}
        </span>
      ))}
    </span>
  ) : (
    <span class:list={['wordmark', className]} {...rest}>
      KYRO
    </span>
  )
}
