---
import { Picture } from 'astro:assets';
import { isPurchasable, type Product } from '../../lib/catalog';
import { routes } from '../../lib/urls';
import Price from './Price.astro';

interface Props {
  product: Product;
  /** true para las primeras tarjetas visibles: se cargan sin esperar. */
  priority?: boolean;
  headingLevel?: 'h2' | 'h3' | undefined;
  /** Ancho que ocupa la tarjeta, para elegir la imagen adecuada. */
  sizes?: string | undefined;
  /**
   * La foto viaja hasta la ficha al navegar (transición entre páginas). Solo donde
   * la pieza aparece una vez en la página: un nombre repetido anula la transición.
   */
  morph?: boolean | undefined;
}
const {
  product,
  priority = false,
  headingLevel: Heading = 'h3',
  sizes = '(min-width: 72rem) 22vw, (min-width: 48rem) 31vw, 46vw',
  morph = false,
} = Astro.props;
const [cover, alternate] = product.data.images;
const purchasable = isPurchasable(product);
const widths = [320, 480, 640, 800, 1000];
---

<article class="product-card">
  <a class="product-card__link" href={routes.product(product.id)}>
    <div class="product-card__media" data-reveal="aperture" data-vt={morph ? `p-${product.id}` : undefined}>
      {
        cover && (
          <Picture
            class="product-card__image"
            src={cover.src}
            alt={cover.alt}
            widths={widths}
            sizes={sizes}
            formats={['avif', 'webp']}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
          />
        )
      }
      {
        alternate && (
          <Picture
            class="product-card__image product-card__image--alternate"
            src={alternate.src}
            alt=""
            widths={widths}
            sizes={sizes}
            formats={['avif', 'webp']}
            loading="lazy"
          />
        )
      }
    </div>
    <div class="product-card__info">
      <Heading class="product-card__name">{product.data.name}</Heading>
      <p class="product-card__price">
        <Price amount={product.data.price.amount} currency={product.data.price.currency} />
      </p>
      <p class="product-card__availability" data-available={purchasable ? 'true' : 'false'}>
        {purchasable ? 'Disponible' : 'No disponible'}
      </p>
    </div>
  </a>
</article>

<style>
  .product-card__link {
    display: grid;
    gap: var(--space-sm);
    text-decoration: none;
    transition: scale var(--duration-fast) var(--ease-out);
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }

  .product-card__media :global(picture),
  .product-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__media :global(img) {
    transition:
      opacity var(--duration-slow) var(--ease-out),
      scale 1400ms var(--ease-out);
  }

  /* Segunda fotografía: aparece al pasar el cursor. */
  .product-card__media :global(.product-card__image--alternate),
  .product-card__media :global(.product-card__image--alternate img) {
    opacity: 0;
  }

  .product-card__info {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .product-card__name {
    justify-self: start;
    padding-bottom: 0.15em;
    background: linear-gradient(var(--color-champagne), var(--color-champagne)) 0 100% / 0% 1px no-repeat;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: 0.01em;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .product-card__price {
    font-size: var(--text-sm);
    color: var(--color-ivory-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Sale de `available` en el catálogo; nunca se supone stock. */
  .product-card__availability {
    grid-column: 1 / -1;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-ivory-muted);
  }

  .product-card__availability[data-available='false'] {
    color: var(--color-champagne);
  }

  /* Cursor: acercamiento lento, segunda foto y subrayado del nombre. */
  @media (hover: hover) and (pointer: fine) {
    .product-card__link:hover .product-card__media :global(.product-card__image--alternate),
    .product-card__link:hover .product-card__media :global(.product-card__image--alternate img) {
      opacity: 1;
    }

    .product-card__link:hover .product-card__media :global(img) {
      scale: 1.045;
    }

    .product-card__link:hover .product-card__name {
      background-size: 100% 1px;
    }
  }

  /* Toque: la tarjeta cede al presionar, como un botón. */
  .product-card__link:active {
    scale: 0.985;
  }

  @media (min-width: 48rem) {
    .product-card__name,
    .product-card__price {
      font-size: var(--text-base);
    }
  }
</style>
