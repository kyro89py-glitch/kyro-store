---
import { routes } from '../../lib/urls';
import LightScreen from '../brand/LightScreen.astro';

// Se muestra mientras no hay productos activos: una cartela de "próximamente" con la
// pantalla de luz de la marca. No inventa fechas, piezas ni promesas.
interface Props {
  headingLevel?: 'h2' | 'h3';
  /** false dentro de una sección que ya tiene su propia línea divisoria. */
  divider?: boolean;
}
const { headingLevel: Heading = 'h2', divider = true } = Astro.props;
---

<div class:list={['empty-collection', { 'empty-collection--divider': divider }]}>
  <LightScreen />
  <div class="empty-collection__copy">
    <Heading class="empty-collection__title editorial" data-reveal="title">
      La primera colección está en preparación.
    </Heading>
    <p class="empty-collection__text muted" data-reveal="rise">Cuando las piezas estén disponibles, las verás aquí.</p>
    <a class="text-link" href={routes.brand()} data-reveal="rise">Conocer la marca</a>
  </div>
</div>

<style>
  .empty-collection {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-md) var(--space-2xl);
  }

  .empty-collection--divider {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-line);
  }

  .empty-collection__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    max-width: 38rem;
  }

  .empty-collection__title {
    font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .empty-collection__text {
    margin-bottom: var(--space-xs);
  }

  @media (min-width: 60rem) {
    .empty-collection {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--space-2xl);
    }
  }
</style>
