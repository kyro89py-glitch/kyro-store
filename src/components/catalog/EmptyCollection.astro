---
import { routes } from '../../lib/urls';

// Se muestra mientras no hay productos activos. No inventa fechas ni promesas.
interface Props {
  headingLevel?: 'h2' | 'h3';
  /** false dentro de una sección que ya tiene su propia línea divisoria. */
  divider?: boolean;
}
const { headingLevel: Heading = 'h2', divider = true } = Astro.props;
---

<div class:list={['empty-collection', { 'empty-collection--divider': divider }]}>
  <Heading class="empty-collection__title editorial">La primera colección está en preparación.</Heading>
  <p class="empty-collection__text muted">Cuando las piezas estén disponibles, las verás aquí.</p>
  <a class="text-link" href={routes.brand()}>Conocer la marca</a>
</div>

<style>
  .empty-collection {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    max-width: 36rem;
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .empty-collection--divider {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-line);
  }

  .empty-collection__title {
    font-size: var(--text-3xl);
  }

  .empty-collection__text {
    margin-bottom: var(--space-xs);
  }
</style>
