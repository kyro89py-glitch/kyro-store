---
import { Picture } from 'astro:assets';
import type { Category, Product } from '../../lib/catalog';
import CategoryNav from './CategoryNav.astro';
import EmptyCollection from './EmptyCollection.astro';
import ProductGrid from './ProductGrid.astro';

// Vista compartida por /tienda/ y /tienda/<categoria>/: título de cartel, recuento real
// del catálogo, filtro por categorías y la cuadrícula.
interface Props {
  title: string;
  products: Product[];
  categories: Category[];
  currentCategory?: string | undefined;
  /** Portada de la categoría: la foto de su panel en la portada viaja hasta aquí. */
  cover?: Category['cover'];
}
const { title, products, categories, currentCategory, cover } = Astro.props;
const count = products.length;
---

<div class="shop container">
  <header class="shop__head">
    <h1 class="shop__title display" data-reveal="title">{title}</h1>
    {
      count > 0 && (
        <p class="shop__count" data-reveal="rise">
          <span class="shop__count-number">{String(count).padStart(2, '0')}</span>
          {count === 1 ? 'pieza' : 'piezas'}
        </p>
      )
    }
    <span class="shop__rule" aria-hidden="true" data-reveal="line"></span>
  </header>
  {
    cover && currentCategory && (
      <div class="shop__cover" data-vt={`c-${currentCategory}`}>
        <Picture
          src={cover.src}
          alt=""
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 90rem) 88rem, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <CategoryNav categories={categories} current={currentCategory} />
  <div class="shop__results">
    {
      count > 0 ? (
        <ProductGrid products={products} label={title} headingLevel="h2" morph />
      ) : (
        <EmptyCollection divider={false} />
      )
    }
  </div>
</div>

<style>
  .shop {
    padding-top: var(--space-2xl);
  }

  .shop__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
  }

  .shop__title {
    /* El título de cartel no debe partir palabras largas de categoría en móvil. */
    overflow-wrap: anywhere;
  }

  .shop__count {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-bottom: 0.6em;
    color: var(--color-ivory-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
  }

  .shop__count-number {
    color: var(--color-ivory);
    font-family: var(--font-editorial);
    font-size: var(--text-2xl);
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Franja de portada: recorte panorámico de la foto de la categoría. */
  .shop__cover {
    position: relative;
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-lg);
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px rgb(241 236 227 / 0.12);
  }

  .shop__cover :global(picture),
  .shop__cover :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(8 9 10 / 0.55), transparent 60%);
  }

  @media (min-width: 48rem) {
    .shop__cover {
      aspect-ratio: 16 / 6;
    }
  }

  .shop__rule {
    flex-basis: 100%;
    height: 1px;
    background: var(--color-line-strong);
  }

  .shop__results {
    margin-top: var(--space-xl);
  }
</style>
