---
import type { Category } from '../../lib/catalog';
import { routes } from '../../lib/urls';

interface Props {
  categories: Category[];
  /** Slug de la categoría actual; undefined en "Todo". */
  current?: string | undefined;
}
const { categories, current } = Astro.props;
---

{
  categories.length > 1 && (
    <nav class="category-nav" aria-label="Categorías">
      <ul role="list">
        <li>
          <a class="nav-link" href={routes.shop()} aria-current={current === undefined ? 'page' : undefined}>
            Todo
          </a>
        </li>
        {categories.map((category) => (
          <li>
            <a
              class="nav-link"
              href={routes.category(category.slug)}
              aria-current={current === category.slug ? 'page' : undefined}
            >
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .category-nav {
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .category-nav ul {
    display: flex;
    gap: var(--space-lg);
    width: max-content;
  }

  .category-nav li {
    padding-block: var(--space-xs);
  }

  .category-nav a {
    color: var(--color-ivory-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-size var(--duration-base) var(--ease-out);
  }

  .category-nav a:hover,
  .category-nav a[aria-current='page'] {
    color: var(--color-ivory);
  }
</style>
