---
import type { Category } from '../../lib/catalog';
import { routes } from '../../lib/urls';

interface Props {
  categories: Category[];
  /** Slug de la categoría actual; undefined en "Todo". */
  current?: string | undefined;
}
const { categories, current } = Astro.props;
const links = [
  { label: 'Todo', href: routes.shop(), current: current === undefined },
  ...categories.map((category) => ({
    label: category.name,
    href: routes.category(category.slug),
    current: current === category.slug,
  })),
];
---

{
  /*
   * El indicador de la categoría actual tiene nombre de transición: al cambiar de
   * categoría, la línea se desliza de un filtro al siguiente entre páginas.
   */
  categories.length > 1 && (
    <nav class="category-nav" aria-label="Categorías">
      <ul role="list">
        {links.map((link) => (
          <li>
            <a class="category-nav__link" href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
              {link.current && <span class="category-nav__indicator" aria-hidden="true" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .category-nav {
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .category-nav ul {
    display: flex;
    gap: var(--space-lg);
    width: max-content;
  }

  .category-nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-sm);
    color: var(--color-ivory-muted);
    font-size: var(--text-sm);
    font-stretch: 112%;
    letter-spacing: 0.03em;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .category-nav__link[aria-current='page'] {
    color: var(--color-ivory);
  }

  .category-nav__link:active {
    color: var(--color-champagne);
  }

  .category-nav__indicator {
    position: absolute;
    inset: auto 0 0.35rem;
    height: 1px;
    background: var(--color-champagne);
    view-transition-name: category-indicator;
  }

  /* Cursor: una línea tenue anticipa el filtro antes de pulsarlo. */
  .category-nav__link::after {
    content: '';
    position: absolute;
    inset: auto 0 0.35rem;
    height: 1px;
    background: var(--color-line-strong);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .category-nav__link:hover {
      color: var(--color-ivory);
    }

    .category-nav__link:not([aria-current='page']):hover::after {
      scale: 1 1;
    }
  }

  @media (forced-colors: active) {
    .category-nav__link[aria-current='page'] {
      text-decoration: underline;
    }
  }
</style>
