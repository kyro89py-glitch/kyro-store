---
import type { Product } from '../../lib/catalog';
import { toSearchItem } from '../../lib/search-data';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  label: string;
  headingLevel?: 'h2' | 'h3';
  /** false cuando la cuadrícula empieza fuera de la primera pantalla (p. ej. en la portada). */
  eager?: boolean;
  /** Las fotos viajan hasta la ficha al navegar (solo si cada pieza aparece una vez). */
  morph?: boolean;
  /** Cada pieza lleva sus datos de búsqueda (/buscar/ filtra y reordena en el navegador). */
  searchable?: boolean;
}
const { products, label, headingLevel, eager = true, morph = false, searchable = false } = Astro.props;
---

<ul class="product-grid" role="list" aria-label={label} data-product-grid>
  {
    products.map((product, index) => (
      <li data-search={searchable ? JSON.stringify(toSearchItem(product, index)) : undefined}>
        <ProductCard product={product} priority={eager && index < 2} headingLevel={headingLevel} morph={morph} />
      </li>
    ))
  }
</ul>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-sm);
  }

  @media (min-width: 48rem) {
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-lg);
    }
  }

  @media (min-width: 72rem) {
    .product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
