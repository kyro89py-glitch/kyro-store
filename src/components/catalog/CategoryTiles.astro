---
import { Picture } from 'astro:assets';
import type { Category } from '../../lib/catalog';
import { routes } from '../../lib/urls';

// Una tarjeta por categoría con la primera foto real de sus productos. En móvil se
// desplazan en horizontal; en escritorio forman una fila editorial.
interface Props {
  categories: Category[];
}
const { categories } = Astro.props;
---

<ul class="categories" role="list" aria-label="Categorías">
  {
    categories.map((category) => (
      <li class="categories__item" data-reveal="aperture">
        <a class="category" href={routes.category(category.slug)}>
          <div class="category__media">
            {category.cover && (
              <Picture
                src={category.cover.src}
                alt=""
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 72rem) 30vw, (min-width: 48rem) 45vw, 72vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            )}
          </div>
          <span class="category__name editorial">{category.name}</span>
          <span class="category__count">
            {category.count} {category.count === 1 ? 'pieza' : 'piezas'}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .categories {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: var(--space-sm);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .categories::-webkit-scrollbar {
    display: none;
  }

  .categories__item {
    scroll-snap-align: start;
  }

  .category {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--space-2xs);
    aspect-ratio: 3 / 4;
    padding: var(--space-lg);
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    isolation: isolate;
    transition: scale var(--duration-fast) var(--ease-out);
  }

  .category:active {
    scale: 0.985;
  }

  .category__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .category__media :global(picture),
  .category__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category__media :global(img) {
    transition: scale 1400ms var(--ease-out);
  }

  /* Velo inferior para que el nombre se lea sobre cualquier fotografía. */
  .category__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(8 9 10 / 0.82));
  }

  .category__name {
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .category__count {
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.04em;
    color: var(--color-ivory);
    opacity: 0.8;
  }

  @media (hover: hover) {
    .category:hover .category__media :global(img) {
      scale: 1.06;
    }

    .category:hover .category__name {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--color-champagne);
      text-underline-offset: 0.18em;
    }
  }

  @media (min-width: 48rem) {
    .categories {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--space-lg);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
</style>
