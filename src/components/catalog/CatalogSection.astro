---
// Sección de catálogo (portada, productos relacionados): título editorial, enlace
// opcional y contenido.
interface Props {
  id: string;
  title: string;
  link?: { label: string; href: string } | undefined;
}
const { id, title, link } = Astro.props;
---

<section class="catalog-section container" aria-labelledby={id}>
  <header class="catalog-section__head">
    <h2 class="catalog-section__title editorial" id={id}>{title}</h2>
    {
      link && (
        <a class="text-link" href={link.href}>
          {link.label}
        </a>
      )
    }
  </header>
  <slot />
</section>

<style>
  .catalog-section {
    padding-top: var(--space-3xl);
  }

  .catalog-section__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-line);
  }

  .catalog-section__title {
    font-size: var(--text-3xl);
  }
</style>
