---
import { routes } from '../../lib/urls';
import CartView from './CartView.astro';
---

<kyro-cart-drawer>
  <dialog class="drawer" aria-labelledby="cart-drawer-title">
    <div class="drawer__panel">
      <header class="drawer__header">
        <h2 class="drawer__title editorial" id="cart-drawer-title">Carrito</h2>
        <button class="drawer__close" type="button" data-drawer-close>Cerrar</button>
      </header>
      <div class="drawer__body">
        <CartView variant="drawer" />
      </div>
      <footer class="drawer__footer">
        <a class="text-link" href={routes.cart()}>Ver el carrito completo</a>
      </footer>
    </div>
  </dialog>
</kyro-cart-drawer>

<style>
  .drawer {
    inset: 0 0 0 auto;
    /* % y no vw: así no invade el hueco reservado para la barra de desplazamiento. */
    width: min(100%, 28rem);
    height: 100%;
    margin: 0;
    background: var(--color-obsidian);
    border-left: 1px solid var(--color-line);
    translate: 100% 0;
    transition:
      translate var(--duration-slow) var(--ease-out),
      overlay var(--duration-slow) allow-discrete,
      display var(--duration-slow) allow-discrete;
  }

  .drawer[open] {
    translate: 0 0;
  }

  @starting-style {
    .drawer[open] {
      translate: 100% 0;
    }
  }

  .drawer::backdrop {
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }

  .drawer[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .drawer[open]::backdrop {
      opacity: 0;
    }
  }

  .drawer__panel {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }

  .drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-height);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }

  .drawer__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
  }

  .drawer__close {
    padding: var(--space-xs) 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-stretch: 112%;
    letter-spacing: 0.03em;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.28em;
  }

  .drawer__close:hover,
  .drawer__close:focus-visible {
    text-decoration-color: var(--color-champagne);
  }

  .drawer__close:active {
    color: var(--color-champagne);
  }

  .drawer__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-lg) var(--gutter);
  }

  .drawer__footer {
    padding: var(--space-md) var(--gutter) calc(var(--space-md) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }
</style>

<script>
  import { OPEN_CART_EVENT } from '../../lib/cart/client';

  interface RefreshableCartView extends HTMLElement {
    refresh(): Promise<void>;
  }

  class KyroCartDrawer extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog');
      if (!dialog) return;

      window.addEventListener(OPEN_CART_EVENT, () => {
        if (dialog.open) return;
        void this.querySelector<RefreshableCartView>('kyro-cart-view')?.refresh();
        dialog.showModal();
      });

      this.querySelector('[data-drawer-close]')?.addEventListener('click', () => dialog.close());

      // Un clic fuera del panel (en el fondo) cierra el carrito.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }

  if (!customElements.get('kyro-cart-drawer')) {
    customElements.define('kyro-cart-drawer', KyroCartDrawer);
  }
</script>
