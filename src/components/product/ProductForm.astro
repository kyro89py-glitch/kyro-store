---
import type { Product } from '../../lib/catalog';
import { isPurchasable } from '../../lib/catalog';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { variants, optionName } = product.data;
const purchasable = isPurchasable(product);
const available = variants.filter((variant) => variant.available);
// Con una sola opción disponible no hay nada que elegir: queda seleccionada.
const preselected = available.length === 1 ? available[0]?.sku : undefined;
const optionId = `option-${product.id}`;
// "esta talla" en el caso habitual; con otro tipo de opción, un genérico correcto.
const optionNoun = optionName.toLowerCase() === 'talla' ? 'esta talla' : 'esta opción';
---

<kyro-product-form data-option-noun={optionNoun}>
  <form class="product-form" novalidate>
    <fieldset class="variants" aria-describedby={`${optionId}-error`}>
      <legend class="variants__legend">{optionName}</legend>
      <div class="variants__options">
        {
          variants.map((variant) => (
            <label class="variant">
              <input
                class="variant__input"
                type="radio"
                name="sku"
                value={variant.sku}
                disabled={!variant.available}
                checked={variant.sku === preselected}
              />
              <span class="variant__label">
                {variant.label}
                {!variant.available && <span class="visually-hidden">(no disponible)</span>}
              </span>
            </label>
          ))
        }
      </div>
      <p class="product-form__error" id={`${optionId}-error`} data-form-error hidden>
        Selecciona una opción de {optionName.toLowerCase()} para continuar.
      </p>
    </fieldset>

    {
      purchasable && (
        <div class="product-form__quantity">
          <p class="variants__legend" id={`${optionId}-quantity`}>
            Cantidad
          </p>
          <div class="quantity" role="group" aria-labelledby={`${optionId}-quantity`} aria-describedby={`${optionId}-quantity-note`}>
            <button class="quantity__step" type="button" aria-label="Restar una unidad" data-quantity-decrease disabled>
              <span aria-hidden="true">−</span>
            </button>
            <output class="quantity__value" aria-live="polite" data-quantity-value>
              1
            </output>
            <button class="quantity__step" type="button" aria-label="Sumar una unidad" data-quantity-increase>
              <span aria-hidden="true">+</span>
            </button>
          </div>
          <p class="product-form__note" id={`${optionId}-quantity-note`} data-quantity-note />
        </div>
      )
    }

    <button class="button button--primary button--block" type="submit" disabled={!purchasable}>
      {purchasable ? 'Añadir al carrito' : 'No disponible'}
    </button>
    <p class="product-form__status" role="status" data-form-status></p>
    <noscript>
      <p class="product-form__status">Para añadir piezas al carrito, activa JavaScript en tu navegador.</p>
    </noscript>
  </form>
</kyro-product-form>

<style>
  .product-form {
    display: grid;
    gap: var(--space-lg);
  }

  .variants {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .variants__legend {
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
    font-stretch: 112%;
    letter-spacing: 0.03em;
    color: var(--color-ivory-muted);
  }

  .variants__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .variant {
    position: relative;
  }

  /* Encima de la etiqueta siempre, también mientras esta escala (pulsación, "latido"). */
  .variant__input {
    position: absolute;
    z-index: 1;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .variant__input:disabled {
    cursor: not-allowed;
  }

  /*
   * Talla: al elegirla, el marfil la llena de abajo arriba y la pieza "late" una vez.
   * Al presionarla (táctil) cede un poco; con cursor, el borde se aclara.
   */
  .variant__label {
    display: grid;
    place-items: center;
    min-width: 3.25rem;
    min-height: 3rem;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-line-strong);
    border-radius: 2px;
    background: linear-gradient(var(--color-ivory), var(--color-ivory)) 0 100% / 100% 0% no-repeat;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-size var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      scale var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .variant__input:hover:not(:disabled) + .variant__label {
      border-color: var(--color-ivory);
    }
  }

  .variant__input:active:not(:disabled) + .variant__label {
    scale: 0.94;
  }

  .variant__input:checked + .variant__label {
    border-color: var(--color-ivory);
    background-size: 100% 100%;
    color: var(--color-obsidian);
    animation: variant-pop 420ms var(--ease-out);
  }

  @keyframes variant-pop {
    40% {
      scale: 1.06;
    }
  }

  .variant__input:focus-visible + .variant__label {
    outline: 2px solid var(--color-champagne);
    outline-offset: 3px;
  }

  .variant__input:disabled + .variant__label {
    border-color: var(--color-line);
    color: var(--color-ivory-muted);
    text-decoration: line-through;
    text-decoration-color: var(--color-ivory-muted);
  }

  /* Alto contraste (Windows): el sistema reemplaza fondos y bordes, y la talla
     elegida dejaría de distinguirse. Se pintan con colores del sistema. */
  @media (forced-colors: active) {
    .variant__label {
      forced-color-adjust: none;
      border-color: ButtonText;
      background: ButtonFace;
      color: ButtonText;
    }

    .variant__input:hover:not(:disabled) + .variant__label,
    .variant__input:checked + .variant__label {
      border-color: Highlight;
    }

    .variant__input:checked + .variant__label {
      background: Highlight;
      color: HighlightText;
    }

    .variant__input:disabled + .variant__label {
      border-color: GrayText;
      color: GrayText;
    }
  }

  .product-form__error {
    font-size: var(--text-sm);
    color: var(--color-champagne);
    animation: error-in var(--duration-slow) var(--ease-out);
  }

  /* Sin talla elegida: las opciones hacen un leve gesto de "aquí". */
  .variants[data-invalid] .variants__options {
    animation: nudge 460ms var(--ease-out);
  }

  /* Añadido: un barrido de luz recorre el botón como confirmación. */
  .product-form [data-added]::after {
    animation: added-sweep 900ms var(--ease-out);
  }

  @keyframes error-in {
    from {
      opacity: 0;
      translate: 0 -0.35rem;
    }
  }

  @keyframes nudge {
    20%,
    60% {
      translate: -4px 0;
    }
    40%,
    80% {
      translate: 4px 0;
    }
  }

  @keyframes added-sweep {
    from {
      translate: -110% 0;
    }
    to {
      translate: 110% 0;
    }
  }

  /* Sin JavaScript no se puede añadir al carrito: no se muestran controles inertes. */
  :global(html:not(.js)) .product-form__quantity,
  :global(html:not(.js)) .product-form button[type='submit'] {
    display: none;
  }

  .product-form__quantity {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
  }

  .product-form__quantity .variants__legend {
    margin-bottom: 0;
  }

  .product-form__note {
    min-height: 1.5em;
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .product-form__status {
    min-height: 1.5em;
    font-size: var(--text-sm);
    color: var(--color-ivory-muted);
  }
</style>

<script>
  import { store } from '../../config/store';
  import { getCart, onCartChange, openCart, updateCart } from '../../lib/cart/client';
  import { addItem, quantityOf } from '../../lib/cart/state';

  const max = store.cart.maxQuantityPerLine;

  class KyroProductForm extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      const error = this.querySelector<HTMLElement>('[data-form-error]');
      const status = this.querySelector<HTMLElement>('[data-form-status]');
      if (!form || !error || !status) return;

      const fieldset = form.querySelector('fieldset');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const decrease = form.querySelector<HTMLButtonElement>('[data-quantity-decrease]');
      const increase = form.querySelector<HTMLButtonElement>('[data-quantity-increase]');
      const value = form.querySelector<HTMLOutputElement>('[data-quantity-value]');
      const note = form.querySelector<HTMLElement>('[data-quantity-note]');
      const noun = this.dataset['optionNoun'] ?? 'esta opción';
      let quantity = 1;

      const selectedSku = () => {
        const sku = new FormData(form).get('sku');
        return typeof sku === 'string' ? sku : null;
      };

      // Lo que aún cabe en el carrito para la talla elegida (el límite es por talla).
      const room = () => {
        const sku = selectedSku();
        return sku ? max - quantityOf(getCart(), sku) : max;
      };

      const renderQuantity = () => {
        const sku = selectedSku();
        const inCart = sku ? quantityOf(getCart(), sku) : 0;
        const limit = Math.max(room(), 1);
        quantity = Math.min(Math.max(quantity, 1), limit);
        if (value) value.textContent = String(quantity);
        if (decrease) decrease.disabled = quantity <= 1;
        if (increase) increase.disabled = quantity >= limit;
        if (note) {
          note.textContent =
            inCart >= max
              ? `Ya tienes el máximo de ${max} unidades de ${noun} en el carrito.`
              : inCart > 0
                ? `Ya tienes ${inCart} en el carrito. Puedes añadir ${max - inCart} más.`
                : '';
        }
      };

      // Reinicia una animación CSS ligada a un atributo (gesto de error, confirmación).
      const replay = (element: Element | null, attribute: string) => {
        if (!element) return;
        element.removeAttribute(attribute);
        void (element as HTMLElement).offsetWidth;
        element.setAttribute(attribute, '');
      };

      decrease?.addEventListener('click', () => {
        quantity -= 1;
        renderQuantity();
      });
      increase?.addEventListener('click', () => {
        quantity += 1;
        renderQuantity();
      });
      onCartChange(renderQuantity);
      renderQuantity();

      form.addEventListener('change', () => {
        error.hidden = true;
        fieldset?.removeAttribute('data-invalid');
        renderQuantity();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const sku = selectedSku();
        if (!sku) {
          error.hidden = false;
          replay(fieldset, 'data-invalid');
          form.querySelector<HTMLInputElement>('input[name="sku"]:not(:disabled)')?.focus();
          return;
        }

        if (room() <= 0) {
          status.textContent = `Ya tienes el máximo de ${max} unidades de ${noun} en el carrito.`;
          return;
        }

        const added = Math.min(quantity, room());
        updateCart((state) => addItem(state, sku, added, max));
        status.textContent = added === 1 ? 'Añadido al carrito.' : `Añadidas ${added} unidades al carrito.`;
        quantity = 1;
        renderQuantity();
        replay(submit, 'data-added');
        openCart();
      });
    }
  }

  if (!customElements.get('kyro-product-form')) {
    customElements.define('kyro-product-form', KyroProductForm);
  }
</script>
