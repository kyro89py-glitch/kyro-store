---
import { getImage, Picture } from 'astro:assets';
import type { Product } from '../../lib/catalog';

interface Props {
  images: Product['data']['images'];
  /**
   * Nombre de transición de la primera foto: la de la tarjeta viaja hasta aquí al
   * abrir la ficha. Las demás se abren como un obturador al entrar en pantalla.
   */
  vt?: string | undefined;
}
const { images, vt } = Astro.props;
const count = images.length;
const pad = (value: number) => String(value).padStart(2, '0');
const widths = [480, 720, 960, 1280, 1600, 2000];
// Versión grande de cada foto: sin JavaScript, cada foto enlaza a ella; con él, se ve
// en el visor a pantalla completa.
const large = await Promise.all(images.map((image) => getImage({ src: image.src, width: 2000, format: 'webp' })));
---

<kyro-gallery class="gallery">
  <ul class="gallery__track" role="list" aria-label="Fotografías del producto" tabindex="0" data-gallery-track>
    {
      images.map((image, index) => (
        <li
          class:list={['gallery__slide', { 'gallery__slide--ia': image.generated }]}
          data-vt={index === 0 ? vt : undefined}
          data-reveal={index === 0 ? undefined : 'aperture'}
        >
          <a
            class="gallery__open"
            href={large[index]?.src}
            data-gallery-open={index}
            aria-label={`Ampliar la foto ${index + 1} de ${count}`}
          >
            <Picture
              src={image.src}
              alt={image.alt}
              widths={widths}
              sizes="(min-width: 60rem) 58vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </a>
          {image.generated && <p class="gallery__tag">Imagen generada con IA</p>}
        </li>
      ))
    }
  </ul>

  {
    count > 1 && (
      <div class="gallery__nav">
        <p class="gallery__counter" aria-hidden="true">
          <span data-gallery-current>01</span>
          <span class="gallery__counter-rule" />
          {pad(count)}
        </p>
        <div class="gallery__dots" role="group" aria-label="Elegir foto" data-gallery-dots>
          {images.map((_, index) => (
            <button
              class="gallery__dot"
              type="button"
              aria-label={`Foto ${index + 1} de ${count}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-gallery-dot={index}
            />
          ))}
        </div>
      </div>
    )
  }

  <dialog class="viewer" aria-label="Fotografías del producto a pantalla completa" data-viewer>
    <ul class="viewer__track" role="list" data-viewer-track>
      {
        images.map((image, index) => (
          <li class="viewer__slide">
            <figure class="viewer__figure">
              <Picture
                src={image.src}
                alt={image.alt}
                widths={[720, 1080, 1600, 2000]}
                sizes="100vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
              />
              {image.generated && <figcaption class="viewer__tag">Imagen generada con IA</figcaption>}
            </figure>
            <span class="visually-hidden">
              Foto {index + 1} de {count}
            </span>
          </li>
        ))
      }
    </ul>
    <div class="viewer__bar">
      {
        count > 1 && (
          <p class="viewer__counter" aria-hidden="true">
            <span data-viewer-current>01</span>
            <span class="gallery__counter-rule" />
            {pad(count)}
          </p>
        )
      }
      <div class="viewer__actions">
        {
          count > 1 && (
            <>
              <button class="viewer__step" type="button" aria-label="Foto anterior" data-viewer-prev>
                <span aria-hidden="true">←</span>
              </button>
              <button class="viewer__step" type="button" aria-label="Foto siguiente" data-viewer-next>
                <span aria-hidden="true">→</span>
              </button>
            </>
          )
        }
        <button class="viewer__close" type="button" data-viewer-close>
          Cerrar
        </button>
      </div>
    </div>
  </dialog>
</kyro-gallery>

<style>
  .gallery {
    position: relative;
    display: block;
  }

  /* Móvil: carrusel horizontal con desplazamiento nativo. */
  .gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__slide {
    position: relative;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    overflow: hidden;
  }

  .gallery__open {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  /* El foco se dibuja dentro de la foto: el carrusel recorta lo que sale de ella. */
  .gallery__open:focus-visible {
    outline-offset: -4px;
  }

  .gallery__slide :global(picture),
  .gallery__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-out);
  }

  /* Las fotos editoriales (modelo de cuerpo entero) se ven enteras, sin recortar. */
  .gallery__slide--ia :global(img) {
    object-fit: contain;
  }

  /* Cursor: la foto se acerca un poco, como invitación a ampliarla. */
  @media (hover: hover) and (pointer: fine) {
    .gallery__open:hover :global(img) {
      scale: 1.025;
    }
  }

  .gallery__tag,
  .viewer__tag {
    position: absolute;
    left: var(--space-sm);
    bottom: var(--space-sm);
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-scrim);
    color: var(--color-ivory);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  /* ---------- Navegación del carrusel (móvil) ---------- */

  .gallery__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--gutter) 0;
  }

  /* Contador de plano: "01 — 03". */
  .gallery__counter,
  .viewer__counter {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .gallery__counter-rule {
    width: 1.25rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .gallery__dots {
    display: flex;
  }

  /* Cada punto es un objetivo táctil de 32 px aunque se dibuje como una raya fina. */
  .gallery__dot {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
  }

  .gallery__dot::before {
    content: '';
    width: 0.9rem;
    height: 2px;
    background: var(--color-line-strong);
    transition:
      width var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .gallery__dot[aria-current='true']::before {
    width: 1.6rem;
    background: var(--color-champagne);
  }

  /* Los puntos solo funcionan con JavaScript: sin él no se muestran. */
  :global(html:not(.js)) .gallery__dots {
    display: none;
  }

  /* Móvil: el carrusel ya se desliza; ahí el obturador sobra. */
  @media (max-width: 59.99rem) {
    :global(html.motion) .gallery__slide[data-reveal]:not(.is-revealed) {
      clip-path: none;
    }

    .gallery__slide[data-reveal].is-revealed {
      animation: none;
    }
  }

  /* Escritorio: imágenes apiladas; la primera a sangre, el resto en pares. */
  @media (min-width: 60rem) {
    .gallery__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xs);
      overflow: visible;
    }

    .gallery__slide:first-child,
    .gallery__slide:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }

    .gallery__nav {
      display: none;
    }
  }

  /* ---------- Visor a pantalla completa ---------- */

  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-obsidian-deep);
    color: var(--color-ivory);
    opacity: 0;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      overlay var(--duration-slow) allow-discrete,
      display var(--duration-slow) allow-discrete;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    opacity: 1;
  }

  @starting-style {
    .viewer[open] {
      opacity: 0;
    }
  }

  .viewer::backdrop {
    background: var(--color-obsidian-deep);
  }

  .viewer__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .viewer__track::-webkit-scrollbar {
    display: none;
  }

  .viewer__slide {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: var(--space-md) var(--gutter) 0;
    scroll-snap-align: center;
  }

  .viewer__figure {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .viewer__figure :global(picture) {
    display: contents;
  }

  /* La foto entera, sin recortes: es para inspeccionar la prenda. Se ancla al marco
     para que su alto nunca dependa del de la imagen. */
  .viewer__figure :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    scale: 0.97;
    transition: scale 700ms var(--ease-out);
  }

  .viewer[open] .viewer__figure :global(img) {
    scale: 1;
  }

  @starting-style {
    .viewer[open] .viewer__figure :global(img) {
      scale: 0.97;
    }
  }

  .viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-height);
    padding: var(--space-xs) var(--gutter) calc(var(--space-xs) + env(safe-area-inset-bottom));
  }

  .viewer__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }

  .viewer__step,
  .viewer__close {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border: 1px solid var(--color-line-strong);
    border-radius: 2px;
    background: none;
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    transition:
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .viewer__step:disabled {
    color: var(--color-line-strong);
    border-color: var(--color-line);
    cursor: not-allowed;
  }

  @media (hover: hover) and (pointer: fine) {
    .viewer__step:hover:not(:disabled),
    .viewer__close:hover {
      border-color: var(--color-ivory);
    }
  }

  .viewer__step:active:not(:disabled),
  .viewer__close:active {
    color: var(--color-champagne);
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer,
    .viewer__figure :global(img),
    .gallery__slide :global(img) {
      transition: none;
    }
  }
</style>

<script>
  // Carrusel móvil: contador y puntos al día; el carrusel solo es una parada del
  // tabulador cuando realmente se desplaza. Visor: se abre en la foto pulsada, se
  // desliza con el dedo, con las flechas del teclado o con sus botones.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const behavior = (): ScrollBehavior => (reduced.matches ? 'auto' : 'smooth');

  class KyroGallery extends HTMLElement {
    #observers: IntersectionObserver[] = [];
    #resize: ResizeObserver | undefined;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-gallery-track]');
      const viewer = this.querySelector<HTMLDialogElement>('[data-viewer]');
      const viewerTrack = this.querySelector<HTMLElement>('[data-viewer-track]');
      if (!track || !viewer || !viewerTrack) return;

      this.#resize = new ResizeObserver(() => {
        track.tabIndex = track.scrollWidth > track.clientWidth ? 0 : -1;
      });
      this.#resize.observe(track);

      const slides = [...track.children] as HTMLElement[];
      const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]')];
      const current = this.querySelector('[data-gallery-current]');
      this.#watch(track, slides, (index) => {
        if (current) current.textContent = String(index + 1).padStart(2, '0');
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      });
      for (const dot of dots) {
        dot.addEventListener('click', () => {
          const slide = slides[Number(dot.dataset['galleryDot'])];
          if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: behavior() });
        });
      }

      // Visor a pantalla completa.
      const viewerSlides = [...viewerTrack.children] as HTMLElement[];
      const prev = viewer.querySelector<HTMLButtonElement>('[data-viewer-prev]');
      const next = viewer.querySelector<HTMLButtonElement>('[data-viewer-next]');
      const viewerCurrent = viewer.querySelector('[data-viewer-current]');
      let index = 0;
      this.#watch(viewerTrack, viewerSlides, (i) => {
        index = i;
        if (viewerCurrent) viewerCurrent.textContent = String(i + 1).padStart(2, '0');
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === viewerSlides.length - 1;
      });
      const go = (i: number, smooth = true) => {
        const slide = viewerSlides[Math.max(0, Math.min(i, viewerSlides.length - 1))];
        if (slide) viewerTrack.scrollTo({ left: slide.offsetLeft, behavior: smooth ? behavior() : 'auto' });
      };

      for (const link of this.querySelectorAll<HTMLAnchorElement>('[data-gallery-open]')) {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          viewer.showModal();
          go(Number(link.dataset['galleryOpen']), false);
          (next && !next.disabled ? next : viewer.querySelector<HTMLElement>('[data-viewer-close]'))?.focus();
        });
      }
      prev?.addEventListener('click', () => go(index - 1));
      next?.addEventListener('click', () => go(index + 1));
      viewer.querySelector('[data-viewer-close]')?.addEventListener('click', () => viewer.close());
      viewer.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') go(index - 1);
        else if (event.key === 'ArrowRight') go(index + 1);
        else return;
        event.preventDefault();
      });
      // Al cerrar, el carrusel de la ficha queda en la foto que se estaba viendo.
      viewer.addEventListener('close', () => {
        const slide = slides[index];
        if (slide && track.scrollWidth > track.clientWidth) track.scrollTo({ left: slide.offsetLeft });
      });
    }

    disconnectedCallback() {
      for (const observer of this.#observers) observer.disconnect();
      this.#resize?.disconnect();
    }

    /** Avisa de qué foto ocupa la mayor parte del carrusel. */
    #watch(root: HTMLElement, slides: HTMLElement[], onChange: (index: number) => void) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) onChange(slides.indexOf(entry.target as HTMLElement));
          }
        },
        { root, threshold: 0.6 },
      );
      for (const slide of slides) observer.observe(slide);
      this.#observers.push(observer);
    }
  }

  if (!customElements.get('kyro-gallery')) {
    customElements.define('kyro-gallery', KyroGallery);
  }
</script>
