---
import CartView from '../components/cart/CartView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Carrito" description="Tu selección de piezas KYRO." cartDrawer={false}>
  <div class="cart-page container">
    <h1 class="cart-page__title display" data-reveal="title">Carrito</h1>
    <span class="cart-page__rule" aria-hidden="true" data-reveal="line"></span>
    <CartView variant="page" />
  </div>
</BaseLayout>

<style>
  .cart-page {
    max-width: 52rem;
    padding-top: var(--space-2xl);
  }

  .cart-page__title {
    font-size: clamp(3rem, 1.6rem + 6vw, 7rem);
  }

  .cart-page__rule {
    display: block;
    height: 1px;
    margin-block: var(--space-md) var(--space-xl);
    background: var(--color-line-strong);
  }
</style>
