---
import LightScreen from '../components/brand/LightScreen.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../lib/urls';
---

<BaseLayout title="Página no encontrada">
  <div class="not-found container">
    <LightScreen class="not-found__screen" focus="center" />
    <div class="not-found__copy">
      <p class="not-found__kicker" data-reveal="rise">Fuera de plano · 404</p>
      <h1 class="not-found__title display" data-reveal="title">Esta página no existe.</h1>
      <p class="muted" data-reveal="rise">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="not-found__actions" data-reveal="rise">
        <a class="button button--primary" href={routes.shop()}>Ver la tienda</a>
        <a class="text-link" href={routes.home()}>Volver al inicio</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .not-found__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }

  .not-found__kicker {
    color: var(--color-champagne);
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.06em;
  }

  .not-found__title {
    max-width: 10em;
    font-size: clamp(2.8rem, 1.6rem + 3.6vw, 5.5rem);
  }

  @media (min-width: 60rem) {
    .not-found {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: end;
      gap: var(--space-2xl);
    }
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-md);
  }
</style>
