---
import type { GetStaticPaths } from 'astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveProducts } from '../../lib/catalog';
import { getLooks, type Look } from '../../lib/looks';
import { routes } from '../../lib/urls';

/*
 * Look: el conjunto como una campaña (vista con modelo) y, sobre todo, cada prenda para
 * examinarla de cerca con fotografías reales (frente, espalda y detalles) y zoom.
 * No vende por sí mismo: enlaza a la ficha de cada prenda cuando existe.
 */
export const getStaticPaths = (async () => {
  const looks = await getLooks();
  const products = await getActiveProducts();
  return looks.map((look) => {
    const garments = look.data.garments.map((garment) => {
      const product = garment.product ? products.find((item) => item.id === garment.product) : undefined;
      if (garment.product && !product) {
        throw new Error(`Look "${look.id}": la prenda "${garment.name}" enlaza a "${garment.product}", que no está a la venta.`);
      }
      return { name: garment.name, href: product ? routes.product(product.id) : undefined };
    });
    return { params: { slug: look.id }, props: { look, garments } };
  });
}) satisfies GetStaticPaths;

interface Props {
  look: Look;
  garments: { name: string; href: string | undefined }[];
}
const { look, garments } = Astro.props;
const { data } = look;
const generated = data.images.some((image) => image.generated);
const real = data.images.filter((image) => !image.generated).length;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="look">
    <div class="look__gallery">
      <ProductGallery images={data.images} label={`Fotografías del ${data.title.replace(/^Look /, 'look ')}`} />
    </div>

    <div class="look__info">
      <div class="look__sticky">
        <p class="look__kicker" data-reveal="rise">
          <a href={routes.home()}>Inicio</a>
          <span class="look__rule" aria-hidden="true"></span>
          Look
        </p>
        <h1 class="look__title editorial" data-reveal="title">{data.title}</h1>
        <p class="look__summary muted" data-reveal="rise">{data.summary}</p>

        {
          garments.length > 0 && (
            <section class="look__garments" aria-labelledby="look-prendas" data-reveal="rise">
              <h2 class="look__heading" id="look-prendas">
                Prendas del look
              </h2>
              <ul role="list">
                {garments.map((garment) => (
                  <li class="look__garment">
                    {garment.href ? (
                      <a class="text-link" href={garment.href}>
                        {garment.name}
                      </a>
                    ) : (
                      <span>{garment.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <p class="look__note muted" data-reveal="rise">
          {
            generated
              ? `La vista con modelo está generada con IA. Las otras ${real} imágenes son fotografías reales de las prendas: ábrelas para ampliarlas y ver cada detalle.`
              : 'Todas son fotografías reales de las prendas: ábrelas para ampliarlas y ver cada detalle.'
          }
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* La columna nunca crece con su contenido (la tira de miniaturas se desplaza dentro). */
  .look {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  .look__info {
    padding-inline: var(--gutter);
  }

  .look__sticky {
    display: grid;
    gap: var(--space-md);
  }

  .look__kicker {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.06em;
  }

  .look__kicker a {
    display: inline-block;
    padding-block: var(--space-xs);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .look__kicker a:hover,
  .look__kicker a:focus-visible {
    color: var(--color-ivory);
  }

  .look__rule {
    width: 1.5rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .look__title {
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .look__summary {
    max-width: var(--measure);
  }

  .look__garments {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-line);
  }

  .look__heading {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .look__garments ul {
    display: grid;
    gap: var(--space-xs);
  }

  .look__garment {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .look__note {
    max-width: var(--measure);
    font-size: var(--text-sm);
  }

  @media (min-width: 60rem) {
    .look {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      width: min(100% - 2 * var(--gutter), var(--max-width));
      margin: var(--space-lg) auto 0;
    }

    .look__info {
      padding-inline: 0;
    }

    .look__sticky {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
      padding-block: var(--space-lg);
    }
  }
</style>
