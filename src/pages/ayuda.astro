---
import { getHelpTopics, helpTitle } from '../config/help';
import { store } from '../config/store';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInfoPages } from '../lib/pages';
import { routes } from '../lib/urls';

/*
 * Ayuda y contacto. El contacto es un enlace mailto: abre la aplicación de correo de
 * quien escribe, así que el sitio nunca dice "mensaje enviado" (no lo sabe). Las
 * preguntas describen solo cómo funciona el sitio hoy (ver src/config/help.ts).
 */
const email = store.contact.email;
const mailto = email ? `mailto:${email}?subject=${encodeURIComponent(`Consulta desde la tienda ${store.name}`)}` : null;
const infoPages = (await getInfoPages()).map((page) => ({ label: page.data.title, href: routes.info(page.id) }));
const topics = getHelpTopics({ infoPages });
---

<BaseLayout
  title={helpTitle}
  description={email
    ? `Cómo contactar con ${store.name} y respuestas sobre el funcionamiento de la tienda.`
    : `Respuestas sobre el funcionamiento de la tienda ${store.name}.`}
>
  <div class="help container">
    <header class="help__head">
      <p class="help__kicker" data-reveal="rise">Atención al cliente</p>
      <h1 class="help__title display" data-reveal="title">{helpTitle}</h1>
      <span class="help__rule" aria-hidden="true" data-reveal="line"></span>
    </header>

    <div class="help__layout">
      {
        email && mailto && (
          <section class="contact" id="contacto" aria-labelledby="contacto-titulo" data-reveal="rise">
            <h2 class="contact__title editorial-italic" id="contacto-titulo">
              Escríbenos
            </h2>
            <p class="contact__text muted">
              Para consultas sobre una pieza, una talla o la tienda. Si preguntas por una pieza, incluye su nombre y la
              talla.
            </p>
            <p class="contact__email editorial">
              {email.split('@')[0]}@<wbr />{email.split('@')[1]}
            </p>
            <div class="contact__actions">
              <a class="button button--primary" href={mailto}>
                Escribir un correo
              </a>
              <button class="button" type="button" data-copy={email} hidden>
                Copiar la dirección
              </button>
            </div>
            <p class="contact__note muted">«Escribir un correo» abre tu aplicación de correo.</p>
            <p class="contact__status" role="status" data-copy-status />
          </section>
        )
      }

      <section class="faq" id="preguntas" aria-labelledby="preguntas-titulo">
        <h2 class="faq__title" id="preguntas-titulo" data-reveal="rise">Preguntas frecuentes</h2>
        <div class="faq__list" data-reveal="rise">
          {
            topics.map((topic, index) => (
              <details class="faq__item" id={topic.id}>
                <summary class="faq__summary">
                  <span class="faq__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="faq__question editorial">{topic.question}</span>
                  <span class="faq__icon" aria-hidden="true" />
                </summary>
                <div class="faq__answer">
                  {topic.answer.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {topic.links && topic.links.length > 0 && (
                    <ul class="faq__links" role="list">
                      {topic.links.map((link) => (
                        <li>
                          <a class="text-link" href={link.href}>
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .help {
    padding-top: var(--space-2xl);
  }

  .help__head {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
  }

  .help__kicker {
    color: var(--color-champagne);
    font-size: var(--text-xs);
    font-stretch: 112%;
    letter-spacing: 0.06em;
  }

  .help__title {
    font-size: clamp(2.6rem, 1.4rem + 5.4vw, 7rem);
    overflow-wrap: anywhere;
  }

  .help__rule {
    justify-self: stretch;
    height: 1px;
    margin-top: var(--space-sm);
    background: var(--color-line-strong);
  }

  .help__layout {
    display: grid;
    gap: var(--space-2xl);
    padding-top: var(--space-xl);
  }

  /* ---------- Contacto: una ficha bajo el mismo haz de luz de la portada ---------- */

  .contact {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    border: 1px solid var(--color-line);
    background:
      linear-gradient(118deg, transparent 12%, rgb(200 179 138 / 0.08) 34%, rgb(200 179 138 / 0.02) 52%, transparent 66%)
        no-repeat,
      var(--color-surface);
  }

  .contact__title {
    font-size: var(--text-3xl);
    line-height: 1.05;
  }

  .contact__text {
    max-width: 30em;
    font-size: var(--text-sm);
  }

  /* La dirección, legible y fácil de seleccionar a mano si no se puede copiar. */
  .contact__email {
    max-width: 100%;
    margin-block: var(--space-xs) var(--space-sm);
    color: var(--color-champagne);
    font-size: clamp(1.45rem, 1.05rem + 1.8vw, 2.3rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    user-select: all;
  }

  /* Dos acciones del mismo ancho, una sobre otra. */
  .contact__actions {
    display: grid;
    gap: var(--space-sm);
    width: min(100%, 22rem);
  }

  .contact__note,
  .contact__status {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .contact__status {
    min-height: 1.5em;
    color: var(--color-ivory);
  }

  /* ---------- Preguntas: índice de planos que se despliegan ---------- */

  .faq {
    display: grid;
    align-content: start;
    gap: var(--space-lg);
  }

  .faq__title {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .faq__item {
    border-top: 1px solid var(--color-line);
    /* Al abrir /ayuda/#<pregunta>, queda a la vista bajo la cabecera fija. */
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .faq__summary {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 1rem;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__index {
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    font-stretch: 112%;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  .faq__question {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .faq__item[open] .faq__question {
    font-style: italic;
  }

  .faq__item[open] .faq__index {
    color: var(--color-champagne);
  }

  /* Más que gira a menos: dos trazos finos. */
  .faq__icon {
    position: relative;
    align-self: center;
    width: 1rem;
    height: 1rem;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentcolor;
    transition: rotate var(--duration-base) var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__summary:hover {
      color: var(--color-champagne);
    }
  }

  .faq__summary:active {
    color: var(--color-champagne);
  }

  .faq__answer {
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
    padding: 0 0 var(--space-lg) calc(2rem + var(--space-md));
    color: var(--color-ivory-muted);
  }

  .faq__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-top: var(--space-xs);
  }

  /* Despliegue suave donde el navegador lo permite; sin él, se abre al instante. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item {
      interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 480ms var(--ease-out),
        content-visibility 480ms allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media (min-width: 60rem) {
    .help__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-2xl);
    }

    /* El contacto queda a mano mientras se leen las preguntas. */
    .contact {
      position: sticky;
      top: calc(var(--header-height) + var(--space-lg));
      padding: var(--space-2xl) var(--space-xl);
    }

    /* Sin contacto publicado, las preguntas ocupan la columna ancha. */
    .faq:only-child {
      grid-column: 2;
    }
  }
</style>

<script>
  // Copiar la dirección: el botón solo aparece si el navegador permite copiar, y el
  // aviso dice lo que de verdad ocurrió.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  let clearStatus: number | undefined;

  if (button && status && window.isSecureContext && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      window.clearTimeout(clearStatus);
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(button.dataset['copy'] ?? '');
        status.textContent = 'Dirección copiada.';
        clearStatus = window.setTimeout(() => (status.textContent = ''), 5000);
      } catch {
        status.textContent = 'No se pudo copiar. Selecciona la dirección para copiarla a mano.';
      }
    });
  }

  // /ayuda/#<pregunta> abre esa pregunta.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>
