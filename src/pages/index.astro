---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Escena from '../components/brand/Escena.astro';
import Colecciones from '../components/catalog/Colecciones.astro';
import FeaturedGrid from '../components/catalog/FeaturedGrid.astro';
import CatalogSection from '../components/catalog/CatalogSection.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import { copy } from '../config/copy';
import { store } from '../config/store';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveProducts, getCategories } from '../lib/catalog';
import { featuredOnly, newestFirst } from '../lib/catalog-views';
import { toJsonLd } from '../lib/text';
import { routes } from '../lib/urls';

const products = await getActiveProducts();
const newArrivals = newestFirst(products, 4);
const featured = featuredOnly(products, 5);
const categories = getCategories(products);
// Hay productos pero ninguno con fecha ni destacado: se muestra la colección tal cual.
const showCollection = products.length > 0 && newArrivals.length === 0 && featured.length === 0;
const campaign = (await getCollection('campaign')).find((entry) => entry.data.placement === 'hero');
const shopLink = { label: 'Ver toda la tienda', href: routes.shop() };

// Datos estructurados de la marca: solo lo que está configurado.
const sameAs = store.social.map((link) => link.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: store.name,
    ...(Astro.site ? { url: Astro.site.href } : {}),
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  ...(Astro.site
    ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: store.name, url: Astro.site.href }]
    : []),
];
---
<BaseLayout header="overlay">
  <script type="application/ld+json" slot="head" set:html={toJsonLd(jsonLd)} />

  {/* Plano secuencia: KYRO en el mundo 3D y, sin corte, las colecciones en profundidad. */}
  <Escena collectionsHref="#colecciones" />
  <Colecciones categories={categories} products={products} />

  {
    newArrivals.length > 0 && (
      <CatalogSection id="novedades" title={copy.home.newArrivalsTitle} link={shopLink}>
        <ProductGrid products={newArrivals} label={copy.home.newArrivalsTitle} eager={false} />
      </CatalogSection>
    )
  }

  {/* Corte a blanco: la única franja marfil del sitio separa las escenas oscuras. */}
  <section class:list={['manifesto', { 'manifesto--foto': campaign }]} aria-label="La marca">
    <div class="manifesto__inner container">
      <div class="manifesto__copy">
        <p class="manifesto__text display" data-reveal="title">{copy.home.manifesto}</p>
        <a class="text-link text-link--dark" href={routes.brand()} data-reveal="rise">Conocer la marca</a>
      </div>
      {
        campaign && (
          <figure class="manifesto__foto" data-reveal="aperture">
            <Picture
              class:list={['manifesto__imagen', `manifesto__imagen--${campaign.data.focus}`]}
              src={campaign.data.image}
              alt={campaign.data.alt}
              widths={[480, 720, 960, 1280, 1600]}
              sizes="(min-width: 60rem) 40vw, 100vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
            {campaign.data.credit && (
              <figcaption class="manifesto__credito">
                {campaign.data.provisional ? 'Imagen provisional · ' : 'Fotografía: '}
                {campaign.data.credit.url ? (
                  <a href={campaign.data.credit.url} rel="noopener noreferrer" target="_blank">
                    {campaign.data.credit.author} / {campaign.data.credit.source}
                  </a>
                ) : (
                  `${campaign.data.credit.author} / ${campaign.data.credit.source}`
                )}
                {` (${campaign.data.credit.license})`}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <CatalogSection id="destacados" title={copy.home.featuredTitle}>
        <FeaturedGrid products={featured} label={copy.home.featuredTitle} />
      </CatalogSection>
    )
  }

  {
    showCollection && (
      <CatalogSection id="coleccion" title={copy.home.collectionTitle} link={shopLink}>
        <ProductGrid products={products.slice(0, 8)} label={copy.home.collectionTitle} eager={false} />
      </CatalogSection>
    )
  }
</BaseLayout>

<style>
  .manifesto {
    margin-top: var(--space-3xl);
    padding-block: var(--space-3xl);
    background: var(--color-ivory);
    color: var(--color-obsidian);
  }

  .manifesto :focus-visible {
    outline-color: var(--color-obsidian);
  }

  .manifesto__inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .manifesto__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-xl);
  }

  .manifesto__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    background: var(--color-obsidian);
  }

  .manifesto__foto :global(picture),
  .manifesto__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .manifesto__foto :global(.manifesto__imagen--top) {
    object-position: 50% 15%;
  }

  .manifesto__foto :global(.manifesto__imagen--bottom) {
    object-position: 50% 85%;
  }

  .manifesto__credito {
    position: absolute;
    inset: auto var(--space-sm) var(--space-sm) auto;
    max-width: calc(100% - 2 * var(--space-sm));
    padding: var(--space-2xs) var(--space-xs);
    background: rgb(8 9 10 / 0.75);
    color: var(--color-ivory-muted);
    font-size: var(--text-xs);
    text-align: right;
  }

  .manifesto__credito a {
    color: var(--color-ivory);
  }

  .manifesto__text {
    max-width: 15em;
    font-size: clamp(2.4rem, 1.2rem + 4.6vw, 6rem);
    line-height: 1;
  }

  @media (min-width: 60rem) {
    .manifesto__inner {
      padding-left: calc(100% / 12 * 3);
    }

    .manifesto--foto .manifesto__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      padding-left: 0;
    }
  }
</style>
