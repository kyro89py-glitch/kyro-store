{%- if section.settings.text != blank -%}
  <div class="announcement">
    <div class="announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Se oculta mientras el texto esté vacío."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios"
    }
  ]
}
{% endschema %}
