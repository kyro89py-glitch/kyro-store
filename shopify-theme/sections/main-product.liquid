{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
-%}

<section class="product" id="Product-{{ section.id }}" data-product>
  <div class="gallery" data-gallery aria-label="{{ 'products.product.gallery' | t }}" role="region">
    <div class="gallery__viewport" data-gallery-viewport>
      {%- for media in product.media -%}
        <div
          class="gallery__slide{% if section.settings.image_fit == 'contain' %} gallery__slide--contain{% endif %}"
          data-gallery-slide
          data-media-id="{{ media.id }}"
          id="Slide-{{ section.id }}-{{ media.id }}"
        >
          {%- if media.media_type == 'image' -%}
            {%- liquid
              if forloop.first
                assign media_loading = 'eager'
                assign media_priority = 'high'
              else
                assign media_loading = 'lazy'
                assign media_priority = 'auto'
              endif
            -%}
            {{
              media.preview_image
              | image_url: width: 2400
              | image_tag:
                loading: media_loading,
                fetchpriority: media_priority,
                sizes: '(min-width: 60em) 54vw, 100vw',
                widths: '540, 720, 960, 1200, 1600, 2000, 2400'
            }}
            {%- if section.settings.enable_zoom -%}
              <button
                type="button"
                class="gallery__zoom"
                data-zoom-src="{{ media.preview_image | image_url: width: 3200 }}"
                data-zoom-alt="{{ media.alt | escape }}"
                data-zoom-width="{{ media.preview_image.width }}"
                data-zoom-height="{{ media.preview_image.height }}"
              >
                <span class="visually-hidden">{{ 'products.product.zoom' | t: index: forloop.index }}</span>
              </button>
            {%- endif -%}
          {%- else -%}
            {{ media | media_tag: image_size: '1600x' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="gallery__slide" data-gallery-slide>{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
    </div>

    {%- if media_count > 1 -%}
      <div class="gallery__dots">
        {%- for media in product.media -%}
          <button
            type="button"
            class="gallery__dot"
            data-gallery-go="{{ forloop.index0 }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="visually-hidden">{{ 'products.product.media_position' | t: index: forloop.index, count: media_count }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="gallery__thumbs">
        {%- for media in product.media -%}
          <button
            type="button"
            class="gallery__thumb"
            data-gallery-go="{{ forloop.index0 }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', widths: '90, 180' }}
            <span class="visually-hidden">{{ 'products.product.media_position' | t: index: forloop.index, count: media_count }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.enable_zoom -%}
      <dialog class="zoom-dialog" data-zoom-dialog aria-label="{{ product.title | escape }}">
        <button type="button" class="icon-button zoom-dialog__close" data-zoom-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'products.product.close_zoom' | t }}</span>
        </button>
        <div class="zoom-dialog__viewport">
          <img alt="" loading="lazy" width="1600" height="2000">
        </div>
      </dialog>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__sticky">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="kicker product__vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}
              <h1 class="product__title editorial">{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, large: true %}
              <p class="muted" style="font-size: var(--text-xs);">
                {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }} {% endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  <a href="{{ shop.shipping_policy.url }}">{{ 'products.product.shipping_at_checkout' | t }}</a>
                {%- else -%}
                  {{ 'products.product.shipping_at_checkout' | t }}
                {%- endif -%}
              </p>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  <fieldset class="option">
                    <legend class="option__legend">
                      {{ option.name | escape }}:
                      <span class="option__selected" data-option-selected>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                        <input
                          class="option__input{% unless value.available %} is-unavailable{% endunless %}"
                          type="radio"
                          id="{{ input_id }}"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          {% if value.selected %}
                            checked
                          {% endif %}
                        >
                        <label class="option__label" for="{{ input_id }}">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="field" {{ block.shopify_attributes }}>
              <label class="field__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <div class="quantity">
                <button type="button" class="quantity__button" data-quantity-step="-1">
                  {% render 'icon', name: 'minus' %}
                  <span class="visually-hidden">{{ 'products.product.decrease' | t }}</span>
                </button>
                <input
                  class="quantity__input"
                  type="number"
                  id="Quantity-{{ section.id }}"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  form="{{ product_form_id }}"
                >
                <button type="button" class="quantity__button" data-quantity-step="1">
                  {% render 'icon', name: 'plus' %}
                  <span class="visually-hidden">{{ 'products.product.increase' | t }}</span>
                </button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                {%- unless product.has_only_default_variant -%}
                  <noscript>
                    <label class="field">
                      <span class="field__label">{{ product.options | join: ' / ' | escape }}</span>
                      <select class="field__input" name="id">
                        {%- for variant in product.variants -%}
                          <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                            {{- variant.title | escape }}
                            {%- unless variant.available %} · {{ 'products.product.sold_out' | t }}{% endunless -%}
                          </option>
                        {%- endfor -%}
                      </select>
                    </label>
                  </noscript>
                {%- endunless -%}
                <p class="product-form__error" data-form-error role="alert" hidden></p>
                <button
                  type="submit"
                  name="add"
                  class="button button--full"
                  data-add-to-cart
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            {%- if block.settings.content != blank or block.settings.page != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading | escape }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}

          {%- when 'policies' -%}
            {%- if shop.shipping_policy.body != blank or shop.refund_policy.body != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading | escape }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content">
                  <ul class="site-footer__links" role="list">
                    {%- if shop.shipping_policy.body != blank -%}
                      <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>
                    {%- endif -%}
                    {%- if shop.refund_policy.body != blank -%}
                      <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>
                    {%- endif -%}
                  </ul>
                </div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="buy-bar" data-buy-bar aria-hidden="true">
    <span class="buy-bar__title">{{ product.title | escape }}</span>
    <button
      type="submit"
      form="{{ product_form_id }}"
      class="button"
      data-add-to-cart
      tabindex="-1"
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      <span data-add-label>
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "image_fit",
      "label": "Encaje de las fotos",
      "options": [
        { "value": "cover", "label": "Llenar el marco (4:5)" },
        { "value": "contain", "label": "Foto completa, sin recorte" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Ampliar las fotos a pantalla completa",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Mostrar la marca o proveedor",
          "default": true
        }
      ]
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Selector de variantes",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "Cantidad",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Mostrar botones de pago exprés",
          "info": "Muestra los medios de pago rápido activos en la tienda.",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "Desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Detalles"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Contenido desde una página"
        }
      ]
    },
    {
      "type": "policies",
      "name": "Envíos y devoluciones",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Envíos y devoluciones"
        },
        {
          "type": "paragraph",
          "content": "Enlaza las políticas de envío y de reembolso creadas en Configuración > Políticas."
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ]
}
{% endschema %}
