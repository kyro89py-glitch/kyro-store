{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign shown = shown | plus: 1
    endif
  endfor
-%}

{%- if shown > 0 or request.design_mode -%}
  <section class="section">
    <div class="page-width">
      {%- if section.settings.heading != blank or section.settings.kicker != blank -%}
        <div class="section-header">
          <div class="section-header__titles">
            {%- if section.settings.kicker != blank -%}
              <p class="kicker" data-reveal>{{ section.settings.kicker | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="section-header__title editorial" data-reveal>{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
          <a class="text-link" href="{{ routes.collections_url }}" data-reveal>{{ 'general.view_all' | t }}</a>
        </div>
      {%- endif -%}

      <div class="collection-tiles" style="--tiles: {{ section.blocks.size | at_least: 1 | at_most: 3 }};">
        {%- for block in section.blocks -%}
          {%- assign tile = block.settings.collection -%}
          {%- if tile != blank -%}
            {%- assign tile_image = block.settings.image | default: tile.featured_image -%}
            <a href="{{ tile.url }}" class="collection-tile" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              {%- if tile_image -%}
                {{
                  tile_image
                  | image_url: width: 1600
                  | image_tag: loading: 'lazy', sizes: '(min-width: 48em) 33vw, 100vw', widths: '540, 720, 960, 1200, 1600'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              <div class="collection-tile__content">
                <h3 class="collection-tile__title editorial">{{ block.settings.title | default: tile.title | escape }}</h3>
                {% render 'icon', name: 'arrow' %}
              </div>
            </a>
          {%- elsif request.design_mode -%}
            <div class="collection-tile" {{ block.shopify_attributes }}>
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Colecciones",
  "tag": "div",
  "class": "section-collection-list",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Colecciones"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Opcional. Si no se elige, se usa la imagen de la colección."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "Opcional. Si no se escribe, se usa el nombre de la colección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
