<section class="section">
  <div class="page-width image-with-text{% if section.settings.layout == 'reverse' %} image-with-text--reverse{% endif %}">
    <div class="image-with-text__media" data-reveal>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag: loading: 'lazy', sizes: '(min-width: 60em) 58vw, 100vw', widths: '540, 720, 960, 1200, 1600, 2000'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
      {%- if section.settings.caption != blank and section.settings.image != blank -%}
        <p class="media-caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.kicker != blank -%}
        <p class="kicker" data-reveal>{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__heading editorial" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte" data-reveal style="--reveal-index: 1;">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="text-link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-reveal style="--reveal-index: 2;">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "tag": "div",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Pie de la imagen",
      "info": "Por ejemplo, «Imagen generada con IA» cuando corresponda."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "default", "label": "Izquierda" },
        { "value": "reverse", "label": "Derecha" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del enlace"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Imagen con texto"
    }
  ]
}
{% endschema %}
