<article class="page-width article">
  <header class="page-header">
    <p class="kicker">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page-header__title editorial">{{ article.title | escape }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '(min-width: 46em) 46rem, 100vw', widths: '720, 960, 1200, 1600, 2000' }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p class="section--tight"><a class="text-link" href="{{ blog.url }}">{{ 'blog.back' | t }}</a></p>
</article>

{% schema %}
{
  "name": "Artículo",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
