{%- liquid
  assign overlay = false
  if section.settings.overlay_on_home and request.page_type == 'index'
    assign overlay = true
  endif
-%}

<header class="site-header{% if overlay %} site-header--overlay{% endif %}" data-header>
  <div class="site-header__inner">
    <button
      class="icon-button site-header__menu-toggle"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="MenuDrawer"
      aria-expanded="false"
    >
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'header.open_menu' | t }}</span>
    </button>

    <nav class="site-header__nav" aria-label="{{ 'header.navigation' | t }}">
      <ul class="nav-list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            {%- if link.links != blank -%}
              <details class="nav-dropdown" data-dismissable>
                <summary>{{ link.title | escape }}</summary>
                <ul class="nav-dropdown__list" role="list">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}" class="nav-link"{% if child.current %} aria-current="page"{% endif %}>
                        {{- child.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="nav-link"{% if link.current %} aria-current="page"{% endif %}>
                {{- link.title | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__brand">
      {% render 'wordmark', eager: true %}
    </a>

    <div class="site-header__actions">
      <a class="icon-button" href="{{ routes.search_url }}">
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>
      <a class="icon-button" href="{{ routes.cart_url }}">
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
        <span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<dialog class="menu-drawer" id="MenuDrawer" data-menu-drawer aria-label="{{ 'header.menu' | t }}">
  <div class="menu-drawer__inner">
    <div class="menu-drawer__top">
      {% render 'wordmark' %}
      <button class="icon-button" type="button" data-menu-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'header.close_menu' | t }}</span>
      </button>
    </div>
    <nav aria-label="{{ 'header.navigation' | t }}">
      <ul class="menu-drawer__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}" class="menu-drawer__link"{% if link.current %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
            {%- if link.links != blank -%}
              <ul class="menu-drawer__sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="menu-drawer__sublink">{{ child.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="menu-drawer__footer">
      <a class="text-link" href="{{ routes.search_url }}">{{ 'header.search' | t }}</a>
      <a class="text-link" href="{{ routes.cart_url }}">{{ 'header.cart' | t }}</a>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "Cabecera",
  "class": "section-site-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "overlay_on_home",
      "label": "Cabecera transparente sobre la imagen de la portada",
      "default": true
    }
  ]
}
{% endschema %}
