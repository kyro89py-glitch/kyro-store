{%- if shop.policies.size > 0 -%}
  <div class="page-width contact-section">
    {%- if section.settings.heading != blank -%}
      <h2 class="kicker" style="margin-bottom: var(--space-lg);">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="policy-list" role="list">
      {%- for policy in shop.policies -%}
        <li>
          <a href="{{ policy.url }}">{{ policy.title | escape }} {% render 'icon', name: 'arrow' %}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Políticas de la tienda",
  "tag": "div",
  "class": "section-policy-links",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lista las políticas creadas en Configuración > Políticas. Si no hay ninguna, la sección no se muestra."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Políticas"
    }
  ],
  "presets": [
    {
      "name": "Políticas de la tienda"
    }
  ]
}
{% endschema %}
