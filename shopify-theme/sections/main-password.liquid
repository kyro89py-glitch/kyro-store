<div class="page-width password-page">
  {% render 'wordmark' %}
  {%- if shop.password_message != blank -%}
    <p class="muted">{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="field">
      <span class="field__label">{{ 'password.password' | t }}</span>
      <input class="field__input" type="password" name="password" autocomplete="current-password" required>
    </label>
    <button type="submit" class="button button--full">{{ 'password.enter' | t }}</button>
  {%- endform -%}
  <p class="muted" style="font-size: var(--text-xs);">
    {{ 'password.admin' | t }}
    <a href="/admin" rel="nofollow">{{ 'password.admin_link' | t }}</a>
  </p>
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "div",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
