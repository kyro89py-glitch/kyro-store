  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "paragraph",
        "content": "Mientras no se cargue un logotipo oficial, la cabecera y el pie muestran el nombre de la marca como marca tipográfica."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Nombre de la marca",
        "default": "KYRO",
        "info": "Se usa en la cabecera y el pie cuando no hay logotipo. Si se deja vacío, se usa el nombre de la tienda."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logotipo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logotipo",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Imagen cuadrada de al menos 64 × 64 px."
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "colors_background",
        "label": "Fondo (obsidiana)",
        "default": "#0e1012"
      },
      {
        "type": "color",
        "id": "colors_background_deep",
        "label": "Fondo profundo (obsidiana profundo)",
        "default": "#08090a"
      },
      {
        "type": "color",
        "id": "colors_text",
        "label": "Texto (marfil)",
